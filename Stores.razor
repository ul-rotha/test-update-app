@page "/stores"
@layout EmptyLayout

<style>
    .status-circle {
        display: inline-block;
        width: 15px;
        height: 15px;
        border-radius: 50%;
        margin-right: 10px;
    }

    .online {
        background-color: #00D26A;
    }

    .offline {
        background-color: #F8312F;
    }

</style>

<PageTitle>stores</PageTitle>

@if (!string.IsNullOrEmpty(errorMsg))
{
    <ErrorComponent ErrorMessage="@errorMsg" />
}
else
{
    @if (stores == null)
    {
        <SkeletonList />
    }
    else
    {
        <MudAppBar Color="Color.Primary" Fixed="false" Dense="true" Elevation="1">
            <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" Class="mr-1" />
            <MudText Typo="Typo.subtitle1">@userName</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Outlined.Logout" Color="Color.Inherit" OnClick="Logout" />
        </MudAppBar>

        <MudItem xs="12" sm="12" Class="mt-2">
            <MudText Typo="Typo.h5" Align="Align.Center" Style=@($"color:{Colors.Gray.Darken1}")>Stores</MudText>
        </MudItem>
        <MudGrid Spacing="0" Justify="Justify.Center">
            <MudItem xs="12" Class="mx-5 my-2">
                <utilsoft_web24.Components.DateTimePicker.UTilDateTimePicker OnDateTimeChanged="OnDateTimeChanged" />
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="0" Justify="Justify.Center">
            <MudItem xs="12" sm="4" md="3" Class="mx-5 my-2">
                <img src="https://i.pinimg.com/originals/83/74/f9/8374f984ffcd7063c61a26113d14a122.gif" height="110" style="width: 100%;" Class="position-relative cursor-pointer d-flex align-items-center bg-white rounded-lg shadow-sm" />
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="0" Justify="Justify.Center">
            @foreach (var item in stores)
            {
                var key = item.StoreId.ToString();

                <MudItem xs="12" sm="4" md="3" @onclick="@(()=>Onclick(item))" Class="position-relative cursor-pointer d-flex align-items-center bg-white rounded-lg shadow-sm py-5 px-2 mx-5 my-2">
                    <MudIcon Icon="@Icons.Material.Outlined.Storefront" Size="Size.Large" Color="Color.Primary" />
                    <MudItem Class="flex-column ml-2">
                        <MudText Typo="Typo.h6" Color="Color.Surface">
                            @item.Title
                        </MudText>

                        <MudText Typo="Typo.subtitle2" Color="Color.Surface">@item.Title2</MudText>
                        <MudItem Style="height:10px;" Class="d-flex align-items-center my-2">
                            @if (salesLoading.Contains(key))
                            {
                                @* <MudText Typo="Typo.subtitle1">Loading...</MudText> *@
                                <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Size="Size.Medium" />
                                @* <MudProgressLinear Color="Color.Primary" Indeterminate="true" /> *@
                            }
                            else if (salesErrors.Contains(key))
                            {
                                <MudText Typo="Typo.subtitle1" Color="Color.Error">
                                    Data not available
                                </MudText>
                            }
                            else if (netSales.TryGetValue(key, out var sales))
                            {
                                <MudText Typo="Typo.subtitle1" Class="fw-bold px-1">$@sales.Money2D()</MudText>
                            }
                        </MudItem>
                    </MudItem>

                    @if (stores.Count > 1)
                    {

                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                       Size="Size.Medium"
                                       Class="position-absolute"
                                       Style="@($"color:{Colors.Gray.Lighten1};top: 0px; right: 0px;")" OnClick="@(()=>SetStore(item))" />
                    }
                </MudItem>
            }

        </MudGrid>

        @if (stores.Count <= 3)
        {
            <MudText Typo="Typo.subtitle2" Align="Align.Center" Style="position: fixed; bottom: 0; width: 100%; text-align: center;">
                <VersionInfo />
            </MudText>
        }
        else
        {
            <VersionInfo />
        }
    }
}

@* @inject HttpClient http *@
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IJSRuntime JS
@using PmCore.Lib
@using PmCore.Lib.PosApp
@code {

    public class DashboardResMod
    {
        public PosDashboardDtoMaster? masterInfo { get; set; }
        public List<PosDashboardDtoSalesByCustomerOrPayments>? payments { get; set; }
        public List<PosDashboardDtoSalesByCustomerOrPayments>? customers { get; set; }
        public List<PosDashboardDtoMenus>? menus { get; set; }
    }

    private DashboardResMod? dashBoard;
    private List<MuStoreMod>? stores;
    private Dictionary<Guid, bool> ConnectionStatuses = new();
    private string? userName = string.Empty;
    private string? errorMsg = "";
    private string? testUrl = "";
    private string? testToken = "";


    private readonly Dictionary<string, float> netSales = new();
    private readonly HashSet<string> salesLoading = new();
    private readonly HashSet<string> salesErrors = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await localStorage.GetItemAsync<MuUserMod?>("user");
            userName = user?.DisplayName ?? user?.Email;
            //stores = await localStorage.GetItemAsync<List<MuStoreMod>?>("user_stores");
            //if (stores == null || stores.Count <= 0)
            //{
            var token = await localStorage.GetItemAsync<string>("token");
            var baseUrl = Configuration["base_url"];
            var url = $"{baseUrl}/api/master/GetStores?muid={user?.Id}";

            using var httpClient = new HttpClient();
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var response = await httpClient.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                stores = await WebApi.SendRequestAsync<List<MuStoreMod>?>(url, token);
                if (stores != null)
                {
                    foreach (var store in stores ?? [])
                    {
                        salesLoading.Add(store.StoreId.ToString());
                    }
                    await localStorage.SetItemAsync("user_stores", stores);
                    _ = GetNetSalesByStore();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await Logout();
            }
            //}
        }
        catch (Exception ex)
        {
            errorMsg = $"{testUrl}\r\ntoken={testToken},{ex.ToString()}";
        }
    }


    private DateFilter? dateFilter = DateFilter.Today;
    private DateTime? fromDate = DateTime.Today;
    private DateTime? toDate = DateTime.Today;
    private async Task OnDateTimeChanged(Tuple<DateFilter?, DateTime?, DateTime?, TimeSpan?, TimeSpan?> obj)
    {
        dateFilter = obj.Item1;
        fromDate = obj.Item2;
        toDate = obj.Item3;
        await GetNetSalesByStore();
    }

    // Maximum number of branch API requests running at the same time.
    private readonly SemaphoreSlim salesSemaphore = new(5);

    // Identifies the latest refresh. Older requests cannot overwrite newer results.
    private int salesLoadVersion = 0;

    private async Task GetNetSalesByStore()
    {
        var currentStores = stores;
        if (currentStores == null || currentStores.Count == 0)
            return;

        // Snapshot the selected dates so all branches in this batch use the same range.
        var dateFrom = fromDate?.ToString("yyyyMMdd");
        var dateTo = toDate?.ToString("yyyyMMdd");
        var version = Interlocked.Increment(ref salesLoadVersion);

        foreach (var store in currentStores)
        {
            var key = store.StoreId.ToString();
            if (store.EnablePosApp == true)
            {
                salesLoading.Add(key);
                salesErrors.Remove(key);
            }
            else
            {
                salesLoading.Remove(key);
            }
        }

        await InvokeAsync(StateHasChanged);

        // Create one task per enabled store. The semaphore limits active HTTP calls to 5.
        var tasks = currentStores
            .Where(store => store.EnablePosApp == true)
            .Select(store => LoadStoreSalesAsync(store, dateFrom, dateTo, version));

        await Task.WhenAll(tasks);
    }

    private async Task LoadStoreSalesAsync(
        MuStoreMod store,
        string? dateFrom,
        string? dateTo,
        int version)
    {
        var key = store.StoreId.ToString();
        var semaphoreEntered = false;

        try
        {
            await salesSemaphore.WaitAsync();
            semaphoreEntered = true;

            // A newer refresh may have started while this task was waiting in the queue.
            if (version != Volatile.Read(ref salesLoadVersion))
                return;

            var storeIndex = store.PosApp2Enable == true ? "2" : "0";
            var url = $"{store.BaseUrl}/api/posapp/GetDashBoard?storeId={store.StoreId}&storeIndex={storeIndex}&dateBy=0&dateFrom={dateFrom}&dateTo={dateTo}";

            using var client = new HttpClient
            {
                Timeout = TimeSpan.FromSeconds(15)
            };

            using var response = await client.GetAsync(url);
            float? sales = null;

            if (response.IsSuccessStatusCode)
            {
                if (storeIndex is "0" or "1")
                {
                    var dashboard = await response.Content.ReadFromJsonAsync<DashboardResMod?>();
                    if (dashboard?.masterInfo != null)
                        sales = dashboard.masterInfo.NetSales ?? 0;
                }
                else
                {
                    var multi = await response.Content.ReadFromJsonAsync<DashboardResMod[]?>();
                    if (multi is { Length: >= 2 } &&
                        multi[0]?.masterInfo != null && multi[1]?.masterInfo != null)
                    {
                        sales = Pfun.SumNullableFloat(
                            multi[0].masterInfo.NetSales,
                            multi[1].masterInfo.NetSales);
                    }
                }
            }

            // Update only this store's UI entry, and only if this is still the latest refresh.
            await InvokeAsync(() =>
            {
                if (version != Volatile.Read(ref salesLoadVersion))
                    return;

                if (sales.HasValue)
                {
                    netSales[key] = sales.Value;
                    salesErrors.Remove(key);
                }
                else
                {
                    salesErrors.Add(key);
                }

                salesLoading.Remove(key);
                StateHasChanged();
            });
        }
        catch (Exception)
        {
            await InvokeAsync(() =>
            {
                if (version != Volatile.Read(ref salesLoadVersion))
                    return;

                salesErrors.Add(key);
                salesLoading.Remove(key);
                StateHasChanged();
            });
        }
        finally
        {
            if (semaphoreEntered)
                salesSemaphore.Release();

        }
    }

    private async Task SetStore(MuStoreMod store)
    {
        await localStorage.SetItemAsync("store_id", store.StoreId);
        await localStorage.SetItemAsync("base_url", store.BaseUrl);
        await localStorage.SetItemAsync("store_name", store.Title);
        await localStorage.SetItemAsync("posapp2_enable", store.PosApp2Enable);
        await localStorage.SetItemAsync(Pvar.CurrentStore, store);
        if (stores?.Count <= 1)
        {
            var userInfo = await localStorage.GetItemAsync<MuUserMod>("user");
            if (userInfo?.EnableAccApp == true && store.EnableAccApp == true)
            {
                Navigation.NavigateTo("dashboard-acc");
            }
            else if (userInfo?.EnableScanApp == true && store.EnableScanApp == true)
            {
                Navigation.NavigateTo("dashboard-scan");
            }
            else if (userInfo?.EnablePosApp == true && store.EnablePosApp == true)
            {
                Navigation.NavigateTo("pos-dashboard");
            }
            else if (userInfo?.EnableTimeApp == true && store.EnableTimeApp == true)
            {
                Navigation.NavigateTo("attendance-list");
            }
        }
    }

    private async Task Onclick(MuStoreMod store)
    {
        await localStorage.SetItemAsync("store_id", store.StoreId);
        await localStorage.SetItemAsync("base_url", store.BaseUrl);
        await localStorage.SetItemAsync("store_name", store.Title);
        await localStorage.SetItemAsync("posapp2_enable", store.PosApp2Enable);
        await localStorage.SetItemAsync(Pvar.CurrentStore, store);

        // Navigation.NavigateTo("attendance-list");
        var userInfo = await localStorage.GetItemAsync<MuUserMod>("user");
        if (userInfo?.EnableAccApp == true && store.EnableAccApp == true)
        {
            Navigation.NavigateTo("dashboard-acc");
        }
        else if (userInfo?.EnableScanApp == true && store.EnableScanApp == true)
        {
            Navigation.NavigateTo("dashboard-scan");
        }
        else if (userInfo?.EnablePosApp == true && store.EnablePosApp == true)
        {
            Navigation.NavigateTo("pos-dashboard");
        }
        else if (userInfo?.EnableTimeApp == true && store.EnableTimeApp == true)
        {
            Navigation.NavigateTo("attendance-list");
        }
    }

    private async Task Logout()
    {
        await localStorage.RemoveItemAsync("token");
        await localStorage.RemoveItemAsync("user_stores");
        // await JS.InvokeVoidAsync("reloadLatestVersion");
        Navigation.NavigateTo(Navigation.BaseUri);
    }

}